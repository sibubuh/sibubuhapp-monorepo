# Public configuration
VITE_APP_NAME=frontend

# Public origin used for canonical URLs, Open Graph and JSON-LD.
# Must be the real origin — a localhost value makes Google drop the canonical.
VITE_PUBLIC_SITE_URL=https://porto.bubuh.id

# Optional absolute URL to a 1200x630 PNG/JPG used as the default og:image.
# VITE_PUBLIC_OG_IMAGE=https://porto.bubuh.id/images/og-default.png

# Server configuration
HOST=0.0.0.0
PORT=3000

# Optional
# ENABLE_RATE_LIMIT=false
